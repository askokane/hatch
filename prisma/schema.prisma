// HATCH — Prisma schema.
// Uses PostgreSQL (Supabase in the hosted deployment). DATABASE_URL is the pooled
// (transaction) connection used at runtime; DIRECT_URL is the direct/session
// connection used for migrations. The schema was originally authored for SQLite —
// the swap was a provider + connection-string change only, no model changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TagKind {
  SKILL
  INTEREST
  DOMAIN
}

enum TagRelation {
  HAS
  LEARNING
}

enum IntentKind {
  COFOUNDER
  TEAMMATE
  MENTOR
  FEEDBACK
  INTERNSHIP
}

enum ProjectStage {
  IDEA
  BUILDING
  LAUNCHED
}

enum ProjectVisibility {
  PUBLIC
  UNLISTED
}

enum Commitment {
  LIGHT
  STEADY
  HEAVY
}

enum RoleStatus {
  OPEN
  FILLED
  CLOSED
}

enum ContextType {
  ROLE
  PROJECT
  INTENT
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum SubjectType {
  PROFILE
  PROJECT
  MESSAGE
  THREAD
  POST
}

enum MediaKind {
  IMAGE
  VIDEO
}

// Accounts are usable the moment they are created. `emailVerifiedAt` is stamped
// at signup and kept as an audit field / hook for a future real mail provider —
// nothing gates on it, so there is no on-platform verification step.
model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  isAdmin         Boolean              @default(false)
  createdAt       DateTime             @default(now())
  sessions        Session[]
  profile         Profile?
  passwordResets  PasswordResetToken[]
  loginAttempts   LoginAttempt[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// DB-backed rate limiter store. Chosen over an in-memory Map so the limit
// survives dev-server restarts (see lib/rate-limit.ts).
model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ip        String
  succeeded Boolean
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Profile {
  id               String         @id @default(cuid())
  userId           String         @unique
  handle           String         @unique
  name             String
  school           String
  gradYear         Int
  // Free text, "City, Country" by convention. Optional — a profile with no
  // location is complete, so nothing gates on it.
  basedIn          String         @default("")
  bio              String         @default("")
  links            Json           @default("[]")
  avatarSeed       String
  isDiscoverable   Boolean        @default(true)
  handleChangedAt  DateTime       @default(now())
  onboardedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags             ProfileTag[]
  intents          Intent[]
  memberships      Membership[]
  updates          Update[]
  createdProjects  Project[]      @relation("ProjectCreator")
  sentRequests     IntroRequest[] @relation("RequestSender")
  receivedRequests IntroRequest[] @relation("RequestRecipient")
  threadMembers    ThreadMember[]
  messages         Message[]
  blocksMade       Block[]        @relation("Blocker")
  blocksReceived   Block[]        @relation("Blocked")
  reportsFiled     Report[]
  posts            Post[]
  mediaAssets      MediaAsset[]

  @@index([school])
  @@index([isDiscoverable])
  // getPeople() sorts the discoverable set by updatedAt. Without this the planner
  // had to sort every matching profile on each people search.
  @@index([isDiscoverable, updatedAt])
}

// The shared university/school catalog behind the type-ahead on onboarding and
// profile edit. Unlike Tag, this is user-grown: the first person to type a school
// creates the row, and everyone after them picks it from the dropdown instead of
// re-typing it. `Profile.school` still stores the name as free text — this table
// is the suggestion source, not a foreign key, so a school can be renamed or
// merged here without rewriting every profile.
//
// `slug` is the identity: lowercase, non-alphanumerics collapsed to "-". It is
// what stops "MIT", "M.I.T." and "mit" from becoming three catalog entries. See
// catalogSlug() in lib/catalog-slug.ts — the migration's backfill uses the same
// normalization in SQL, and the two must stay in step.
model School {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  // Serves the prefix/substring type-ahead ordering.
  @@index([name])
}

model Tag {
  id          String       @id @default(cuid())
  slug        String       @unique
  label       String
  kind        TagKind
  aliases     Json         @default("[]")
  profileTags ProfileTag[]
  projectTags ProjectTag[]
  roleTags    RoleTag[]

  @@index([kind])
}

// Audit log of free-text tag input that did not match the taxonomy. The taxonomy
// is now user-grown — createTagAction() creates the Tag row on the spot — so this
// is no longer a queue of things to action. It is kept as the provenance record:
// `rawText` is what the user actually typed before normalization, and
// `resolvedTagId` is the row it produced, which is what makes a bad or duplicate
// tag traceable back to its origin.
model TagSuggestion {
  id            String   @id @default(cuid())
  rawText       String
  suggestedBy   String?
  kind          TagKind?
  resolved      Boolean  @default(false)
  resolvedTagId String?
  createdAt     DateTime @default(now())

  @@index([resolved])
}

model ProfileTag {
  profileId String
  tagId     String
  relation  TagRelation
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId, relation])
  @@index([tagId])
}

model Intent {
  id        String     @id @default(cuid())
  profileId String
  kind      IntentKind
  note      String     @default("")
  createdAt DateTime   @default(now())
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind])
  @@index([profileId])
}

model Project {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String
  stage       ProjectStage
  visibility  ProjectVisibility @default(PUBLIC)
  links       Json              @default("[]")
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  closedAt    DateTime?
  createdBy   Profile           @relation("ProjectCreator", fields: [createdById], references: [id])
  tags        ProjectTag[]
  memberships Membership[]
  updates     Update[]
  openRoles   OpenRole[]

  @@index([stage])
  @@index([visibility])
  // getProjects() lists public, non-closed projects newest-first.
  @@index([visibility, createdAt])
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
}

model Membership {
  id        String   @id @default(cuid())
  projectId String
  profileId String
  role      String
  isOwner   Boolean  @default(false)
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([profileId])
}

model Update {
  id              String   @id @default(cuid())
  projectId       String
  authorProfileId String
  body            String
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author          Profile  @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model OpenRole {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String
  commitment  Commitment
  status      RoleStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tags        RoleTag[]

  @@index([projectId])
  @@index([status])
  // The discover feed pages OPEN roles newest-first; this serves both the filter
  // and the ordering from one index.
  @@index([status, createdAt])
}

model RoleTag {
  openRoleId String
  tagId      String
  openRole   OpenRole @relation(fields: [openRoleId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([openRoleId, tagId])
  @@index([tagId])
}

model IntroRequest {
  id            String        @id @default(cuid())
  fromProfileId String
  toProfileId   String
  contextType   ContextType
  contextId     String
  note          String
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  respondedAt   DateTime?
  fromProfile   Profile       @relation("RequestSender", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile     Profile       @relation("RequestRecipient", fields: [toProfileId], references: [id], onDelete: Cascade)
  thread        Thread?

  @@index([toProfileId, status])
  @@index([fromProfileId, status])
}

model Thread {
  id             String         @id @default(cuid())
  introRequestId String         @unique
  contextType    ContextType
  contextId      String
  createdAt      DateTime       @default(now())
  introRequest   IntroRequest   @relation(fields: [introRequestId], references: [id], onDelete: Cascade)
  members        ThreadMember[]
  messages       Message[]
}

model ThreadMember {
  threadId    String
  profileId   String
  // Read receipts: every message in the thread authored by the OTHER member and
  // created at or before this instant has been seen by this member.
  lastReadAt  DateTime  @default(now())
  // Typing presence. Set a few seconds into the future while this member types;
  // any reader treats `typingUntil > now()` as "currently typing". Storing an
  // expiry rather than a boolean means a disconnected client self-heals — there
  // is no stuck "typing…" to clean up.
  typingUntil DateTime?
  thread      Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([threadId, profileId])
  @@index([profileId])
}

model Message {
  id              String   @id @default(cuid())
  threadId        String
  authorProfileId String
  body            String
  createdAt       DateTime @default(now())
  thread          Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author          Profile  @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)

  // Supersedes a plain [threadId, createdAt]: that prefix still serves transcript
  // paging identically, and carrying authorProfileId makes the unread-count query
  // behind /api/nav-counts — the app's hottest read — satisfiable from the index
  // alone, with no heap lookup per counted row. Kept as one index rather than two
  // so sending a message still only maintains one.
  @@index([threadId, createdAt, authorProfileId])
}

// A profile post — the feed's first-party content type, alongside the project
// updates and open roles the feed also carries. Body may be empty ONLY when the
// post carries media, so a post is never entirely blank (enforced in the action).
model Post {
  id              String       @id @default(cuid())
  authorProfileId String
  body            String
  createdAt       DateTime     @default(now())
  author          Profile      @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)
  media           MediaAsset[]

  // The profile tab pages one author's posts newest-first.
  @@index([authorProfileId, createdAt])
  // The global feed pages every post newest-first; it is one of three sources
  // merged on createdAt, so each source must be independently ordered cheaply.
  @@index([createdAt])
}

// Uploaded photo/video bytes, stored in Postgres as `bytea` and served by
// GET /api/media/[id].
//
// Storing blobs in the database is a deliberate scope choice, not an oversight:
// the app's standing constraint is no paid services and no API keys, and the
// hosted target (Vercel) has no writable persistent filesystem, so the local
// disk is not actually an option. The DB is the only durable store present.
// The caps in lib/constants.ts (IMAGE_BYTES_MAX / VIDEO_BYTES_MAX) are what keep
// that honest. The upgrade path is a swap of two functions — the upload route
// would PUT to object storage and this row would hold a key instead of `data`;
// nothing else reads `data` directly.
//
// `postId` is null between upload and attachment: the composer uploads first to
// get an id, then creates the post referencing it. Assets left unattached are
// bounded per profile (PENDING_UPLOAD_MAX) and swept when the composer's own
// post is created, so an abandoned upload cannot accumulate without limit.
model MediaAsset {
  id             String    @id @default(cuid())
  ownerProfileId String
  postId         String?
  kind           MediaKind
  mimeType       String
  data           Bytes
  byteSize       Int
  // Original filename is kept for the download/alt affordance only; it is never
  // used to build a path.
  fileName       String    @default("")
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  owner          Profile   @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  post           Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  // Serves the pending-upload quota check (postId null for one owner).
  @@index([ownerProfileId, postId])
}

model Block {
  id               String   @id @default(cuid())
  blockerProfileId String
  blockedProfileId String
  createdAt        DateTime @default(now())
  blocker          Profile  @relation("Blocker", fields: [blockerProfileId], references: [id], onDelete: Cascade)
  blocked          Profile  @relation("Blocked", fields: [blockedProfileId], references: [id], onDelete: Cascade)

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockedProfileId])
}

model Report {
  id                String      @id @default(cuid())
  reporterProfileId String
  subjectType       SubjectType
  subjectId         String
  reason            String
  detail            String      @default("")
  createdAt         DateTime    @default(now())
  reporter          Profile     @relation(fields: [reporterProfileId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId])
}
