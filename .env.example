# --- HATCH environment ---

# PostgreSQL (Supabase in the hosted deployment).
# DATABASE_URL = pooled / transaction connection (port 6543), used at runtime.
#   Append ?pgbouncer=true&connection_limit=1 for serverless.
# DIRECT_URL   = direct / session connection (port 5432), used for migrations & seed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Registration accepts ANY valid email by default. Set REQUIRE_EDU_EMAIL=true to
# restrict signups to .edu domains (school-only mode).
# REQUIRE_EDU_EMAIL="true"

# Only used when REQUIRE_EDU_EMAIL=true: extra addresses/domains allowed through
# (comma-separated full emails and/or "@domain"). Honored outside production only.
DEV_EMAIL_ALLOWLIST="@stateu.edu,@hatchdemo.edu"

# No mail provider is wired up: verification / password-reset links are printed to
# the server console AND surfaced in the UI so the flow is completable without an
# inbox. Set MAIL_ENABLED=true once you integrate a real email provider.
# MAIL_ENABLED="true"

# Base URL used when printing dev verification / password-reset links to the console
# (and building absolute links). Set to your deployed URL in production.
APP_URL="http://localhost:3000"
